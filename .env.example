# Copy to .env and adjust. See README for DEV vs PROD.

# ---------- Environment (dev | prod) ----------
# dev: CPU-only, cache off by default, optional Redis
# prod: GPU when CUDA available, cache on by default, GEMINI_API_KEY required
APP_ENV=dev

# ---------- Required for LLM (required in prod) ----------
GEMINI_API_KEY=your_gemini_api_key

# ---------- Database (PostgreSQL, sync psycopg2 driver) ----------
# Start Postgres locally (docker compose up -d postgres) or install natively, then:
#   createdb english_practice
#   alembic upgrade head
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/english_practice

# ---------- Test database (used by pytest fixtures) ----------
# TEST_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/english_practice_test

# ---------- Admin bootstrap (optional) ----------
# ADMIN_BOOTSTRAP_EMAIL=admin@example.com
# ADMIN_BOOTSTRAP_PASSWORD=change-me

# ---------- Razorpay subscriptions ----------
# Test/live plan IDs should be created in Razorpay Dashboard ahead of time.
# APP_ENV decides which plan ids are used:
# - dev -> *_TEST
# - prod -> *_LIVE
# RAZORPAY_KEY_ID=rzp_test_xxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxx
# RAZORPAY_WEBHOOK_SECRET=xxxxxxxx
# RAZORPAY_WEBHOOK_SECRET_PREVIOUS=
# RAZORPAY_PLAN_ID_VUVL_PLUS_TEST=plan_xxxxx
# RAZORPAY_PLAN_ID_VUVL_PRO_TEST=plan_xxxxx
# RAZORPAY_PLAN_ID_VUVL_PLUS_LIVE=plan_xxxxx
# RAZORPAY_PLAN_ID_VUVL_PRO_LIVE=plan_xxxxx
# RAZORPAY_TIMEOUT_SECONDS=15
# RAZORPAY_MONTHLY_TOTAL_COUNT=1200
# RAZORPAY_CHECKOUT_REUSE_MINUTES=30

# ---------- Redis (optional in dev; recommended in prod) ----------
REDIS_URL=redis://localhost:6379/0

# ---------- Agora RTC (social voice matchmaking) ----------
# Required for MATCH_FOUND tokens when using /api/v1/social/ws
# AGORA_APP_ID=
# AGORA_APP_CERTIFICATE=
# AGORA_TOKEN_TTL_SECONDS=3600
# CACHE_ENABLED: in prod defaults to true when unset; set to false to disable
# CACHE_ENABLED=false

# ---------- Timeouts (seconds) for LLM, STT, TTS ----------
LLM_TIMEOUT_SECONDS=60
STT_TIMEOUT_SECONDS=30
TTS_TIMEOUT_SECONDS=45

# ---------- STT: faster_whisper_medium | faster_whisper_large ----------
STT_MODE=faster_whisper_large

# ---------- TTS: Chatterbox (local GPU vs Resemble API) ----------
# local (default): local Chatterbox-Turbo on GPU; requires TTS_AUDIO_PROMPT_PATH
# api: Resemble AI https://f.cluster.resemble.ai/stream (requires RESEMBLE_API_KEY + RESEMBLE_VOICE_UUID)
# TTS_CHATTERBOX_MODE=local
# RESEMBLE_API_KEY=your_resemble_api_key
# RESEMBLE_VOICE_UUID=your_voice_uuid
# RESEMBLE_API_MODEL=chatterbox-turbo
# RESEMBLE_SAMPLE_RATE=44100
# RESEMBLE_PRECISION=PCM_16
# RESEMBLE_USE_HD=false
# RESEMBLE_API_TIMEOUT=30
# RESEMBLE_API_MAX_RETRIES=2

# Path to ~10s WAV for voice cloning (required for local Turbo)
TTS_AUDIO_PROMPT_PATH=chirp3-hd-puck.wav

# ---------- TTS: Gemini Indic (when IndicF5 off or fails). Requires GEMINI_API_KEY ----------
# TTS_GEMINI_MODEL_INDIC=gemini-2.5-flash-preview-tts

# ---------- TTS: IndicF5 (Indic languages). Optional. ----------
# TTS_INDICF5_REF_AUDIO_DIR=/path/to/IndicF5/prompts
# On Apple Silicon, IndicF5 uses CPU automatically (MPS lacks ComplexFloat for F5). Optional: force CPU on CUDA too.
# TTS_INDICF5_FORCE_CPU=false

# ---------- S3 (optional; prod RunPod often uses this) ----------
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=your-bucket
# S3_PRESIGNED_EXPIRY_SECONDS=3600

# ---------- App (optional) ----------
# DEBUG=false
# AUDIO_STORAGE_PATH=/path/to/audio_storage
# AUDIO_BASE_URL=http://localhost:8000/audio

# ========== Example: Production (e.g. RunPod with GPU) ==========
# APP_ENV=prod
# GEMINI_API_KEY=your_key
# DATABASE_URL=postgresql+psycopg2://user:password@postgres:5432/english_practice
# CACHE_ENABLED=true
# REDIS_URL=redis://...
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# S3_BUCKET_NAME=...
# STT_MODE=faster_whisper_large
